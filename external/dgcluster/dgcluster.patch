+def read_metis_graph(filename):
+    """
+    Reads an unweighted graph in METIS format.
+    Returns the number of vertices and an edge list.
+    """
+    with open(filename, "r") as f:
+        # Skip comment lines
+        first_line = ""
+        for line in f:
+            if line.strip() and not line.startswith('%'):
+                first_line = line.strip()
+                break
+
+        parts = first_line.split()
+        n_vertices = int(parts[0])
+        n_edges = int(parts[1])
+        t = 0
+        if (len(parts) > 2):
+            t = int(parts[2])
+
+        vertex_weights = (t == 10 or t == 11)
+        edge_weights = (t == 1 or t == 11)
+        
+        edge_list = []
+
+        for u, line in enumerate(f):
+            if not line.strip() or line.startswith('%'):
+                continue
+
+            N = list(map(int, line.split()))
+            if vertex_weights:
+                N = N[1:]
+
+            if edge_weights:
+                N = zip(N[::2], N[1::2])
+                for v, w in N:
+                    if v - 1 > u:  # only add each edge once
+                        edge_list.append([u, v - 1])
+            else:
+                for v in N:
+                    if v - 1 > u:  # only add each edge once
+                        edge_list.append([u, v - 1])
+    
+    return n_vertices, edge_list
+
+def read_features(filename, n_vertices):
+    """
+    Reads node features from a file.
+    If filename is None, returns a tensor of 1.0 for each vertex.
+    """
+    if filename is None:
+        return torch.ones((n_vertices, 1))
+
+    with open(filename, "r") as f:
+        # Read header
+        header = f.readline().split()
+        num_nodes = int(header[0])
+        num_features = int(header[1])
+
+        # Read features
+        features = []
+        for line in f:
+            if not line.strip():
+                continue
+            features.append(list(map(float, line.split())))
+    
+    return torch.tensor(features)
+
 
