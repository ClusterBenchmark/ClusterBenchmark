+def read_metis_graph(filename):
+    """
+    Reads an unweighted graph in METIS format.
+    The parser should be able to handle vertex and/or edge weights,
+    but ignore them.
+    Returns the number of vertices and an edge list.
+    """
+    with open(filename, "r") as f:
+        # Skip comment lines
+        first_line = ""
+        for line in f:
+            if line.strip() and not line.startswith('%'):
+                first_line = line.strip()
+                break
+
+        parts = first_line.split()
+        n_vertices = int(parts[0])
+        n_edges = int(parts[1])
+        t = 0
+        if (len(parts) > 2):
+            t = int(parts[2])
+
+        vertex_weights = (t == 10 or t == 11)
+        edge_weights = (t == 1 or t == 11)
+
+        edge_list = []
+        for u, line in enumerate(f):
+            if not line.strip() or line.startswith('%'):
+                continue
+
+            N = list(map(int, line.split()))
+            if vertex_weights:
+                N = N[1:]
+
+            if edge_weights:
+                # Create a zip object of tuples for N
+                N = zip(N[::2], N[1::2])
+                for v, w in N:
+                    if v - 1 > u:  # only add each edge once
+                        edge_list.append([u, v - 1])
+            else:
+                for v in N:
+                    if v - 1 > u:  # only add each edge once
+                        edge_list.append([u, v - 1])
+    
+    return n_vertices, edge_list
+
+
+def read_features(filename, n_vertices):
+    """
+    Reads node features from a file.
+    The file has a header with the number of rows and columns.
+    If filename is None, returns a tensor of 1.0 for each vertex.
+    """
+    if filename is None:
+        return torch.ones((n_vertices, 1))
+
+    with open(filename, "r") as f:
+        # Read header
+        header = f.readline().split()
+        num_rows = int(header[0])
+        num_cols = int(header[1])
+
+        features = []
+        for line in f:
+            if not line.strip():
+                continue
+            features.append(list(map(float, line.split())))
+    
+    return torch.tensor(features)
+
+
+def write_clusters(filename, clusters):
+    """
+    Writes the cluster assignments to a file.
+    """
+    with open(filename, 'w') as f:
+        for cluster_id in clusters:
+            f.write(f'{cluster_id}\n')
+
