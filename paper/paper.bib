@inproceedings{Gaertler2005,
  abstract           = {Clustering is a synonym for the decomposition of a set of entities into `natural groups'. There are two major aspects to this task: the first involves algorithmic issues on how to find such decompositions, i.e., tractability, while the second concerns quality assignment, i.e., how good is the computed decomposition. Owing to the informal notion of natural groups, many different disciplines have developed their view of clustering independently.},
